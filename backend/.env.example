# Football API Configuration
# Copy this file to .env and fill in your API key

# Get your API key from: https://dashboard.api-football.com/soccer/tester
FOOTBALL_API_KEY=seu-chave-aqui-123abc

# Database (obrigatorio)
DB_PASSWORD=sua-senha-do-banco

# Administrador inicial (criado se nao existir)
ADMIN_NOME=Admin
ADMIN_EMAIL=admin@footballleague.com
ADMIN_PASSWORD=admin123

# JWT
JWT_SECRET=troque-por-uma-chave-longa-e-secreta
JWT_EXPIRATION_MS=86400000
